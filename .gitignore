.DS_Store

# Local command-line tools, installed per-machine. Not part of the site.
.tools/

# Local agent config, contains machine-specific absolute paths.
# Exception: committed skills (e.g. the Road to D1 new-episode skill).
.claude/*
!.claude/skills/

# --- Road to D1 animation pipeline (road-to-d1/) ---
